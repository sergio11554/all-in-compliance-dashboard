ISMS_HOST=127.0.0.1
ISMS_PORT=5173
ISMS_PUBLIC_URL=https://isms.example.com
ISMS_COOKIE_SECURE=1
ISMS_COOKIE_SAMESITE=Lax
ISMS_HSTS=1

# Session and size limits.
ISMS_SESSION_SECONDS=28800
ISMS_MAX_JSON_BYTES=8388608
ISMS_MAX_UPLOAD_BYTES=41943040
ISMS_MAX_TENANT_EXPORT_BYTES=268435456
ISMS_WORKSPACE_SNAPSHOT_LIMIT=50

# Privilegierte Rollen duerfen produktive Aenderungen erst nach eigener MFA-Aktivierung ausfuehren.
# Lesen sowie MFA-Setup bleiben moeglich, damit Konten nicht ausgesperrt werden.
ISMS_MFA_ENFORCEMENT=write
ISMS_MFA_REQUIRED_ROLES=admin,consultant,manager

# Persistenter Schutz lokaler Anmeldungen. Sperren bleiben über App-Neustarts erhalten.
ISMS_LOGIN_ACCOUNT_MAX_ATTEMPTS=8
ISMS_LOGIN_IP_MAX_ATTEMPTS=30
ISMS_LOGIN_ATTEMPT_WINDOW_SECONDS=900
ISMS_LOGIN_LOCK_SECONDS=900

# Zentrale Passwortregeln fuer lokale Konten. Initialpasswoerter muessen beim ersten Login ersetzt werden.
ISMS_PASSWORD_MIN_LENGTH=12
ISMS_PASSWORD_MAX_LENGTH=256
ISMS_PASSWORD_HISTORY_COUNT=5

# Sichere Kontowiederherstellung über einen einmalig nutzbaren, zeitlich begrenzten Link.
# Benötigt zusätzlich ISMS_NOTIFICATION_SMTP_HOST und ISMS_NOTIFICATION_SMTP_FROM.
ISMS_ACCOUNT_RECOVERY_ENABLED=1
ISMS_ACCOUNT_RECOVERY_TOKEN_SECONDS=3600

# Mandantengeschützter Live-Stream; 45-Sekunden-Polling bleibt als Rückfall aktiv.
ISMS_EVENT_STREAM_SECONDS=55
ISMS_EVENT_HEARTBEAT_SECONDS=15
ISMS_EVENT_RETENTION_DAYS=7

# Server-side technical alarm checks. Disable only if an external scheduler performs the checks.
ISMS_OPERATIONS_MONITOR_ENABLED=1
ISMS_OPERATIONS_MONITOR_SECONDS=300

# Background jobs for longer technical tasks such as backups and operations checks.
ISMS_JOB_WORKER_ENABLED=1
ISMS_JOB_WORKER_SECONDS=15
ISMS_JOB_MAX_ATTEMPTS=3

# Controlled outbound notification delivery. Disabled by default.
ISMS_NOTIFICATION_DELIVERY_ENABLED=0
ISMS_NOTIFICATION_DELIVERY_SECONDS=30
ISMS_NOTIFICATION_MAX_ATTEMPTS=5

# Optional signed webhook. URL and secret must both be set.
# ISMS_NOTIFICATION_WEBHOOK_URL=https://automation.example.com/sfm-notifications
# ISMS_NOTIFICATION_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Optional SMTP delivery to one fixed, server-configured recipient.
# ISMS_NOTIFICATION_SMTP_HOST=smtp.example.com
# ISMS_NOTIFICATION_SMTP_PORT=587
# ISMS_NOTIFICATION_SMTP_USER=sfm-notifications@example.com
# ISMS_NOTIFICATION_SMTP_PASSWORD=replace-with-the-smtp-password
# ISMS_NOTIFICATION_SMTP_FROM=sfm-notifications@example.com
# ISMS_NOTIFICATION_SMTP_TO=isms-review@example.com
# ISMS_NOTIFICATION_SMTP_TLS=1

# Send customer invitations directly to the invited address using the SMTP settings above.
# Keep disabled until SMTP and ISMS_PUBLIC_URL are configured and tested.
ISMS_INVITATION_EMAIL_ENABLED=0

# Set these before first productive use. Do not commit real values.
ISMS_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ISMS_FILE_KEY=replace-with-a-long-random-file-encryption-secret

# Dateiablage: lokal fuer Einzelbetrieb, s3 fuer mehrere App-Instanzen/Produktion.
ISMS_STORAGE_BACKEND=local
# ISMS_S3_ENDPOINT=https://s3.example.com
# ISMS_S3_BUCKET=sfm-compliance-evidence
# ISMS_S3_PREFIX=uploads
# ISMS_S3_REGION=eu-central-1
# ISMS_S3_ACCESS_KEY=replace-with-storage-access-key
# ISMS_S3_SECRET_KEY=replace-with-storage-secret-key
# ISMS_S3_ADDRESSING_STYLE=path
# ISMS_S3_AUTO_CREATE_BUCKET=0

# Nur fuer das optionale lokale MinIO-Profil (`docker compose --profile s3 ...`).
# MINIO_ROOT_USER=sfm-storage-admin
# MINIO_ROOT_PASSWORD=replace-with-a-long-random-storage-password

# Optionales Enterprise-SSO (OIDC). Client-Secrets nur in geschuetzter Deployment-Konfiguration ablegen.
# Die Person muss bereits eingeladen sein oder im Kundenraum dieselbe hinterlegte E-Mail-Adresse besitzen.
# ISMS_OIDC_PROVIDERS_JSON=[{"id":"customer-sso","name":"Mit Unternehmenskonto anmelden","issuer":"https://identity.example.com/tenant/v2.0","clientId":"replace-with-client-id","clientSecret":"replace-with-client-secret","tenantSlug":"customer-slug","allowedDomains":["customer.example"],"algorithms":["RS256"]}]
ISMS_OIDC_STATE_SECONDS=600
ISMS_OIDC_ALLOW_INSECURE=0

# Malware-Prüfung für Uploads. Im Produktivbetrieb `clamav` und `required=1` verwenden.
ISMS_MALWARE_SCAN_MODE=disabled
ISMS_MALWARE_SCAN_REQUIRED=0
ISMS_CLAMAV_HOST=clamav
ISMS_CLAMAV_PORT=3310
ISMS_CLAMAV_TIMEOUT_SECONDS=15

# Optional: move data outside the app folder for server deployments.
# ISMS_DATA_DIR=/var/lib/isms-catalyst

# Static frontend directory when backend and frontend are deployed separately.
# ISMS_STATIC_BASE=/opt/isms-catalyst/frontend

# Docker Compose helper settings.
SFM_HTTP_PORT=5173
# ClamAV 1.4.3 wird auf ARM-Macs über Docker-Emulation ausgeführt.
SFM_CLAMAV_PLATFORM=linux/amd64
# Optional override. Repository and new release packages use ./frontend-current by default.
# SFM_FRONTEND_DIR=/absolute/path/to/frontend-current

# PostgreSQL production datastore. Leave DATABASE_URL empty only for local SQLite mode.
POSTGRES_DB=sfm_compliance
POSTGRES_USER=sfm
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://sfm:replace-with-a-long-random-database-password@postgres:5432/sfm_compliance
